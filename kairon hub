    local TabBar = Instance.new("Frame", Win)
    TabBar.Size = UDim2.new(1,-16,0,34)
    TabBar.Position = UDim2.new(0,8,0,50)
    TabBar.BackgroundColor3 = Color3.fromRGB(14,14,22)
    TabBar.BorderSizePixel = 0
    Corner(TabBar, 8)
    local TBL = Instance.new("UIListLayout", TabBar)
    TBL.FillDirection = Enum.FillDirection.Horizontal
    TBL.Padding = UDim.new(0,3)
    TBL.VerticalAlignment = Enum.VerticalAlignment.Center
    TBL.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local ContentArea = Instance.new("Frame", Win)
    ContentArea.Size = UDim2.new(1,-16,1,-100)
    ContentArea.Position = UDim2.new(0,8,0,90)
    ContentArea.BackgroundTransparency = 1

    local Pages, TBtns = {}, {}

    local function SetTab(name)
        for n,p in pairs(Pages) do p.Visible=(n==name) end
        for n,b in pairs(TBtns) do
            Tween(b, {
                BackgroundColor3 = (n==name) and Color3.fromRGB(55,55,120) or Color3.fromRGB(20,20,34),
                TextColor3 = (n==name) and Color3.fromRGB(255,255,255) or Color3.fromRGB(100,100,135)
            }, 0.15)
        end
    end

    local function NewTab(icon, name)
        local display = icon.." "..name
        local B = Instance.new("TextButton", TabBar)
        B.Size = UDim2.new(0,90,0,28)
        B.BackgroundColor3 = Color3.fromRGB(20,20,34)
        B.Text = display
        B.TextColor3 = Color3.fromRGB(100,100,135)
        B.TextSize = 11
        B.Font = Enum.Font.GothamBold
        B.BorderSizePixel = 0
        B.AutoButtonColor = false
        Corner(B, 6)
        TBtns[name] = B

        local SF = Instance.new("ScrollingFrame", ContentArea)
        SF.Size = UDim2.new(1,0,1,0)
        SF.BackgroundTransparency = 1
        SF.BorderSizePixel = 0
        SF.ScrollBarThickness = 3
        SF.ScrollBarImageColor3 = Color3.fromRGB(60,60,120)
        SF.Visible = false
        Pages[name] = SF

        local LL = Instance.new("UIListLayout", SF)
        LL.Padding = UDim.new(0,5)
        LL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            SF.CanvasSize = UDim2.new(0,0,0,LL.AbsoluteContentSize.Y+10)
        end)
        local Pad = Instance.new("UIPadding", SF)
        Pad.PaddingTop = UDim.new(0,4)
        Pad.PaddingRight = UDim.new(0,5)

        B.MouseButton1Down:Connect(function() SetTab(name) end)
        return SF
    end

    local function Sect(pg, txt)
        local L = Instance.new("TextLabel", pg)
        L.Size = UDim2.new(1,-4,0,20)
        L.BackgroundTransparency = 1
        L.Text = " ╸ "..txt
        L.TextColor3 = Color3.fromRGB(70,70,148)
        L.TextSize = 11
        L.Font = Enum.Font.GothamBold
        L.TextXAlignment = Enum.TextXAlignment.Left
    end

    local function Tog(pg, lbl, key, onOn, onOff)
        local Row = Instance.new("TextButton", pg)
        Row.Size = UDim2.new(1,-4,0,40)
        Row.BackgroundColor3 = Color3.fromRGB(16,16,26)
        Row.Text = ""
        Row.AutoButtonColor = false
        Row.BorderSizePixel = 0
        Corner(Row, 7)

        local Lb = Instance.new("TextLabel", Row)
        Lb.Size = UDim2.new(1,-58,1,0)
        Lb.Position = UDim2.new(0,12,0,0)
        Lb.BackgroundTransparency = 1
        Lb.Text = lbl
        Lb.TextColor3 = Color3.fromRGB(188,188,210)
        Lb.TextSize = 13
        Lb.Font = Enum.Font.Gotham
        Lb.TextXAlignment = Enum.TextXAlignment.Left

        local PBg = Instance.new("Frame", Row)
        PBg.Size = UDim2.new(0,42,0,20)
        PBg.Position = UDim2.new(1,-50,0.5,-10)
        PBg.BackgroundColor3 = Color3.fromRGB(35,35,52)
        PBg.BorderSizePixel = 0
        Corner(PBg, 12)

        local Dot = Instance.new("Frame", PBg)
        Dot.Size = UDim2.new(0,15,0,15)
        Dot.Position = UDim2.new(0,3,0.5,-7.5)
        Dot.BackgroundColor3 = Color3.fromRGB(100,100,125)
        Dot.BorderSizePixel = 0
        Corner(Dot, 12)

        local function Refresh()
            if S[key] then
                Tween(PBg,{BackgroundColor3=Color3.fromRGB(50,168,88)},0.18)
                Tween(Dot,{Position=UDim2.new(1,-18,0.5,-7.5),BackgroundColor3=Color3.fromRGB(255,255,255)},0.18)
            else
                Tween(PBg,{BackgroundColor3=Color3.fromRGB(35,35,52)},0.18)
                Tween(Dot,{Position=UDim2.new(0,3,0.5,-7.5),BackgroundColor3=Color3.fromRGB(100,100,125)},0.18)
            end
        end

        Row.MouseEnter:Connect(function()
            if not S[key] then Tween(Row,{BackgroundColor3=Color3.fromRGB(20,20,32)},0.1) end
        end)
        Row.MouseLeave:Connect(function()
            Tween(Row,{BackgroundColor3=Color3.fromRGB(16,16,26)},0.1)
        end)
        Row.MouseButton1Down:Connect(function()
            S[key] = not S[key]
            Refresh()
            if S[key] and onOn then onOn() end
            if not S[key] and onOff then onOff() end
        end)
    end

    local function Act(pg, lbl, cb)
        local B = Instance.new("TextButton", pg)
        B.Size = UDim2.new(1,-4,0,36)
        B.BackgroundColor3 = Color3.fromRGB(18,18,30)
        B.Text = "▸ "..lbl
        B.TextColor3 = Color3.fromRGB(165,165,210)
        B.TextSize = 13
        B.Font = Enum.Font.Gotham
        B.TextXAlignment = Enum.TextXAlignment.Left
        B.BorderSizePixel = 0
        B.AutoButtonColor = false
        Corner(B, 7)
        local Pd = Instance.new("UIPadding", B)
        Pd.PaddingLeft = UDim.new(0,12)

        B.MouseEnter:Connect(function()
            Tween(B,{BackgroundColor3=Color3.fromRGB(28,28,46),TextColor3=Color3.fromRGB(200,200,255)},0.12)
        end)
        B.MouseLeave:Connect(function()
            Tween(B,{BackgroundColor3=Color3.fromRGB(18,18,30),TextColor3=Color3.fromRGB(165,165,210)},0.12)
        end)
        B.MouseButton1Down:Connect(function()
            Tween(B,{BackgroundColor3=Color3.fromRGB(40,40,72)},0.08)
            task.delay(0.12,function() Tween(B,{BackgroundColor3=Color3.fromRGB(18,18,30)},0.12) end)
            task.spawn(cb)
        end)
    end

    local CPage = NewTab("⚔","Combat")
    Sect(CPage,"TOGGLES")
    Tog(CPage,"Auto Farm","AutoFarm")
    Tog(CPage,"Kill Aura","KillAura")
    Tog(CPage,"Auto Heal","AutoHeal")
    Tog(CPage,"Auto Chest","AutoChest")
    Tog(CPage,"No Clip","NoClip")
    Sect(CPage,"MANUAL")
    Act(CPage,"Attack Nearest Mob",function()
        local r=NearestMob(800) if r then Attack(r) end
    end)
    Act(CPage,"Kill Nearest Player",function()
        local r=NearestPlayer(300) if r then Attack(r) end
    end)
    Act(CPage,"TP To Nearest Player",function()
        local r=NearestPlayer(math.huge)
        if r then TP(r.CFrame*CFrame.new(0,5,3)) end
    end)
    Act(CPage,"Bring All Players To Me",function()
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP and p.Character then
                local r=p.Character:FindFirstChild("HumanoidRootPart")
                if r then r.CFrame=Root.CFrame*CFrame.new(math.random(-4,4),0,math.random(-4,4)) end
            end
        end
    end)

    local V4Page = NewTab("🌀","V4")
    Sect(V4Page,"AUTO V4")
    Tog(V4Page,"Auto V4 (All Gears)","AutoV4")
    Sect(V4Page,"TELEPORT TO GEARS")
    for _, name in ipairs({"Gear 1","Gear 2","Gear 3","Gear 4","Gear 5","Gear 6","Gear 7","Gear 8","Gear 9","Gear 10"}) do
        Act(V4Page,name,function() TP(V4Locs[name]) end)
    end

    local FMPage = NewTab("🌙","Full Moon")
    Sect(FMPage,"AUTO FULL MOON")
    Tog(FMPage,"Auto Full Moon","AutoFullMoon")
    Sect(FMPage,"MOON STATUS")
    Act(FMPage,"Check Moon Phase",function()
        local phase = game:GetService("Lighting"):GetMoonPhase()
        local status = phase >= 0.9 or phase <= 0.1 and "🌕 FULL MOON!" or "🌗 Not Full Moon (" .. string.format("%.2f", phase) .. ")"
        Notify("Moon Phase", status, 3)
    end)

    local TPage = NewTab("🗺","Teleport")
    Sect(TPage,"SEA 1")
    for _,n in ipairs({"Starter Island","Jungle","Pirate Village","Middle Town",
        "Frozen Village","Marine Fortress","Skylands","Colosseum",
        "Magma Village","Underwater City"}) do
        Act(TPage,n,function() TP(Locs[n]) end)
    end
    Sect(TPage,"SEA 2")
    for _,n in ipairs({"Kingdom of Rose","Green Zone","Graveyard","Snow Mountain",
        "Hot & Cold","Wano","Thriller Bark","Flooded Island"}) do
        Act(TPage,n,function() TP(Locs[n]) end)
    end
    Sect(TPage,"SEA 3")
    for _,n in ipairs({"Port Town","Hydra Island","Great Tree","Floating Turtle",
        "Haunted Castle","Sea of Treats"}) do
        Act(TPage,n,function() TP(Locs[n]) end)
    end

    local PPage = NewTab("👤","Player")
    Sect(PPage,"MOVEMENT")
    Tog(PPage,"Fly (WASD + Space / Ctrl)","Fly",StartFly,StopFly)
    Sect(PPage,"FLY SPEED")
    Act(PPage,"Speed +20",function() S.FlySpeed=math.min(S.FlySpeed+20,400) end)
    Act(PPage,"Speed -20",function() S.FlySpeed=math.max(S.FlySpeed-20,20) end)
    Sect(PPage,"KILL AURA RANGE")
    Act(PPage,"Range +5",function() S.KARange=S.KARange+5 end)
    Act(PPage,"Range -5",function() S.KARange=math.max(S.KARange-5,5) end)
    Sect(PPage,"SERVER")
    Act(PPage,"Rejoin Server",function()
        game:GetService("TeleportService"):Teleport(game.PlaceId,LP)
    end)

    local mini = false
    MinBtn.MouseButton1Down:Connect(function()
        mini = not mini
        ContentArea.Visible = not mini
        TabBar.Visible = not mini
        Tween(Win,{Size=mini and UDim2.new(0,400,0,50) or UDim2.new(0,420,0,550)},0.2)
        MinBtn.Text = mini and "+" or "─"
    end)

    UserInputService.InputBegan:Connect(function(i,gpe)
        if gpe then return end
        if i.KeyCode==Enum.KeyCode.RightAlt then
            Win.Visible = not Win.Visible
        end
    end)

    SetTab("Combat")
    warn("[KaironHub v5] Loaded | RightAlt = toggle")
end
