    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 16, 0, 16)
    thumb.Position = UDim2.new((default - min) / (max - min), -0.02, 0.5, -8)
    thumb.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track

    local thc = Instance.new("UICorner")
    thc.CornerRadius = UDim.new(1, 0)
    thc.Parent = thumb

    local dragging = false
    local value = default

    thumb.MouseButton1Down:Connect(function() dragging = true end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    track.MouseButton1Down:Connect(function()
        local mouse = player:GetMouse()
        local pos = math.clamp((mouse.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * pos)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        thumb.Position = UDim2.new(pos, -8, 0.5, -8)
        vl.Text = tostring(value)
        callback(value)
        updateCanvas()
    end)

    thumb.MouseMoved:Connect(function()
        if dragging then
            local mouse = player:GetMouse()
            local pos = math.clamp((mouse.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * pos)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            thumb.Position = UDim2.new(pos, -8, 0.5, -8)
            vl.Text = tostring(value)
            callback(value)
            updateCanvas()
        end
    end)
    updateCanvas()
    return thumb
end

