            value = math.floor(min + (max - min) * pos)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            thumb.Position = UDim2.new(pos, -7, 0.5, -7)
            vl.Text = tostring(value)
            callback(value)
            updateCanvas()
        end
    end)
    updateCanvas()
    return thumb
