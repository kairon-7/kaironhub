local function updateCanvas()
    task.wait(0.05)
    local height = 10
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") and child.Visible then
            local maxY = 0
            for _, sub in ipairs(child:GetChildren()) do
                if sub:IsA("Frame") then
                    local pos = sub.Position.Y.Offset + sub.Size.Y.Offset
                    if pos > maxY then maxY = pos end
                end
            end
            height = height + maxY + 50
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(height, scroll.Size.Y.Offset + 10))
end

