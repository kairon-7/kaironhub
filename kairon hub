    local function IsFullMoon()
        local lighting = game:GetService("Lighting")
        local moonPhase = lighting:GetMoonPhase()
        return moonPhase >= 0.9 or moonPhase <= 0.1
    end

    local function TP(cf)
        if not Root then return end
        if typeof(cf) == "Vector3" then
            cf = CFrame.new(cf + Vector3.new(0,5,0))
        end
        Root.CFrame = cf
    end

    local function NearestMob(range)
        local best, bestD = nil, range or 1000
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= Char then
                local h = obj:FindFirstChildWhichIsA("Humanoid")
                local r = obj:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                    local d = (Root.Position - r.Position).Magnitude
                    if d < bestD then best, bestD = r, d end
                end
            end
        end
        return best
    end

    local function NearestPlayer(range)
        local best, bestD = nil, range or math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildWhichIsA("Humanoid")
                if r and h and h.Health > 0 then
                    local d = (Root.Position - r.Position).Magnitude
                    if d < bestD then best, bestD = r, d end
                end
            end
        end
        return best
    end

    local function Attack(targetRoot)
        if not targetRoot or not Root then return end
        TP(targetRoot.CFrame * CFrame.new(0,3,-3))
        task.wait(0.06)

        local tool = Char:FindFirstChildOfClass("Tool")
        if not tool then
            tool = LP.Backpack:FindFirstChildOfClass("Tool")
            if tool then tool.Parent = Char end
        end

        if tool then
            task.wait(0.05)
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    pcall(function() v:FireServer() end)
                end
            end
            pcall(function() tool:Activate() end)
        end

        local model = targetRoot.Parent
        if model then
            for _, v in ipairs(model:GetDescendants()) do
                if v:IsA("ClickDetector") and HAS_FCP then
                    pcall(function() fireclickdetector(v) end)
                end
                if v:IsA("ProximityPrompt") and HAS_FPP then
                    pcall(function() fireproximityprompt(v) end)
                end
            end
        end

        if HAS_FRI and model then
            for _, v in ipairs(model:GetDescendants()) do
                if v:IsA("BasePart") then
                    pcall(function() firetouchinterest(Root,v,0) end)
                end
            end
        end
    end

    local function StartFly()
        if S.FlyConn then pcall(function() S.FlyConn:Disconnect() end) end
        S.Fly = true
        local Cam = workspace.CurrentCamera
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(9e9,9e9,9e9)
        bg.P = 9e4
        bg.CFrame = Root.CFrame
        bg.Parent = Root

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9,9e9,9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = Root

        S.FlyConn = RunService.Heartbeat:Connect(function()
            if not S.Fly or not Root then
                pcall(function() bg:Destroy() bv:Destroy() end)
                S.FlyConn:Disconnect()
                return
            end
            local d = Vector3.zero
            local UIS = UserInputService
            if UIS:IsKeyDown(Enum.KeyCode.W) then d += Cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d -= Cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d -= Cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d += Cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.new(0,1,0) end
            bv.Velocity = d.Magnitude > 0 and d.Unit * S.FlySpeed or Vector3.zero
            bg.CFrame = Cam.CFrame
        end)
    end

    local function StopFly()
        S.Fly = false
    end

    local function AutoV4Tick()
        if not Root then return end
        for name, loc in pairs(V4Locs) do
            TP(loc)
            task.wait(0.3)
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and (obj.Name:lower():find("v4") or obj.Name:lower():find("gear")) then
                    local part = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if part then
                        TP(CFrame.new(part.Position + Vector3.new(0,4,0)))
                        task.wait(0.2)
                        for _, v in ipairs(obj:GetDescendants()) do
                            if v:IsA("ProximityPrompt") and HAS_FPP then
                                pcall(function() fireproximityprompt(v) end)
                            end
                            if v:IsA("ClickDetector") and HAS_FCP then
                                pcall(function() fireclickdetector(v) end)
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end

    local function AutoFullMoonTick()
