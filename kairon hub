        d.Parent = f
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.35, 0, 0.7, 0)
    btn.Position = UDim2.new(0.6, 0, 0.15, 0)
    btn.Text = default or options[1]
    btn.TextColor3 = Color3.fromRGB(200, 200, 255)
    btn.TextSize = 12
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 65)
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Gotham
    btn.Parent = f

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 4)
    bc.Parent = btn

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -25, 0, 0)
    arrow.Text = "v"
    arrow.TextColor3 = Color3.fromRGB(150, 150, 210)
    arrow.TextSize = 10
    arrow.BackgroundTransparency = 1
    arrow.Font = Enum.Font.Gotham
    arrow.Parent = btn

    local isOpen = false
    local content

    btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            content = Instance.new("Frame")
            content.Size = UDim2.new(0.35, 0, 0, #options * 30 + 5)
            content.Position = UDim2.new(0.6, 0, 1, 2)
            content.BackgroundColor3 = Color3.fromRGB(25, 25, 55)
            content.BackgroundTransparency = 0.1
            content.BorderSizePixel = 0
            content.ClipsDescendants = true
            content.Parent = f

            local cc = Instance.new("UICorner")
            cc.CornerRadius = UDim.new(0, 4)
            cc.Parent = content

            for i, option in ipairs(options) do
                local ob = Instance.new("TextButton")
                ob.Size = UDim2.new(1, 0, 0, 30)
                ob.Position = UDim2.new(0, 0, 0, (i-1) * 30)
                ob.Text = option
                ob.TextColor3 = Color3.fromRGB(200, 200, 245)
                ob.TextSize = 11
                ob.BackgroundTransparency = 1
                ob.Font = Enum.Font.Gotham
                ob.Parent = content

                ob.MouseEnter:Connect(function()
                    ob.BackgroundTransparency = 0.3
                    ob.BackgroundColor3 = Color3.fromRGB(60, 60, 110)
                end)
                ob.MouseLeave:Connect(function()
                    ob.BackgroundTransparency = 1
                end)

                ob.MouseButton1Click:Connect(function()
                    btn.Text = option
                    callback(option)
                    isOpen = false
                    content:Destroy()
                    updateCanvas()
                end)
            end
            updateCanvas()
        else
            if content then content:Destroy() end
        end
    end)
    updateCanvas()
    return btn
end

local farmSec = Section(tabContents[1], "Auto Farm")
local farmRunning = false

Tog(farmSec, "Auto Farm Level", "Farm levels automatically", false, function(v)
    farmRunning = v
    if v then
        StarterGui:SetCore("SendNotification", {Title = "Kairon Hub", Text = "Auto Farm Started", Duration = 2})
        spawn(function()
            while farmRunning do
                wait(0.1)
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    for _, enemy in ipairs(Workspace:GetDescendants()) do
                        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy ~= char then
                            local root = enemy:FindFirstChild("HumanoidRootPart")
                            if root then
                                char.HumanoidRootPart.CFrame = root.CFrame + Vector3.new(0, 0, 5)
                                wait(0.05)
                            end
                        end
                    end
                end
            end
        end)
    else
        StarterGui:SetCore("SendNotification", {Title = "Kairon Hub", Text = "Auto Farm Stopped", Duration = 2})
    end
end)

