local teleSec = Section(tabContents[5], "Teleport")
local selectedTeleport = "Island 1"

local function TeleportTo(location)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local positions = {
        ["Island 1"] = Vector3.new(-100, 0, 0),
        ["Island 2"] = Vector3.new(100, 0, 0),
        ["Island 3"] = Vector3.new(0, 0, 100),
        ["Boss Area"] = Vector3.new(0, 0, -100),
        ["Safe Zone"] = Vector3.new(0, 10, 0),
        ["Sky"] = Vector3.new(0, 100, 0),
        ["Cafe"] = Vector3.new(0, 5, 50)
    }
    if positions[location] then
        char.HumanoidRootPart.CFrame = CFrame.new(positions[location])
        StarterGui:SetCore("SendNotification", {Title = "Kairon Hub", Text = "Teleported to " .. location, Duration = 2})
    else
        StarterGui:SetCore("SendNotification", {Title = "Kairon Hub", Text = "Location not found", Duration = 2})
    end
end

