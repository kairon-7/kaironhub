-- Kairon Hub Minimal Working Version
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local char = lp.Character or lp.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")

-- Simple GUI
local screen = Instance.new("ScreenGui")
screen.Parent = game:GetService("CoreGui")
screen.Name = "KaironHub"

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 400)
frame.Position = UDim2.new(0.5, -150, 0.5, -200)
frame.BackgroundColor3 = Color3.fromRGB(10, 10, 18)
frame.BackgroundTransparency = 0.9
frame.Parent = screen
frame.Active = true
frame.Draggable = true

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "KAIRON HUB v5"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.BackgroundTransparency = 1
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -35, 0, 5)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeBtn.Parent = frame
closeBtn.MouseButton1Click:Connect(function() screen:Destroy() end)

local corner2 = Instance.new("UICorner")
corner2.CornerRadius = UDim.new(0, 6)
corner2.Parent = closeBtn

-- Toggle buttons
local y = 50
local toggles = {
    "Auto Farm",
    "Kill Aura",
    "Auto Heal",
    "Auto Chest",
    "No Clip",
    "Fly"
}
local states = {}

for i, name in ipairs(toggles) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Position = UDim2.new(0.05, 0, 0, y + (i-1) * 42)
    btn.Text = name .. " [OFF]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 34)
    btn.Parent = frame
    btn.Name = name
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    
    states[name] = false
    
    btn.MouseButton1Click:Connect(function()
        states[name] = not states[name]
        btn.Text = name .. (states[name] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = states[name] and Color3.fromRGB(40, 100, 40) or Color3.fromRGB(20, 20, 34)
    end)
end

-- Teleport buttons
local y2 = 50 + #toggles * 42 + 10
local teleports = {
    "Starter Island",
    "Jungle", 
    "Middle Town",
    "Kingdom of Rose",
    "Sea of Treats"
}

local teleLocs = {
    ["Starter Island"] = CFrame.new(975.9, 15.8, 1818.3),
    ["Jungle"] = CFrame.new(-1615.7, 22.1, -296.7),
    ["Middle Town"] = CFrame.new(326.4, 15.8, 793.8),
    ["Kingdom of Rose"] = CFrame.new(-234.4, 15.8, -2827.9),
    ["Sea of Treats"] = CFrame.new(-11079.5, 15.8, -4869.3)
}

for i, name in ipairs(teleports) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.4, 0, 0, 30)
    btn.Position = UDim2.new(0.05 + (i-1) % 2 * 0.5, 0, 0, y2 + math.floor((i-1)/2) * 36)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 11
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    btn.Parent = frame
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        if root then
            root.CFrame = teleLocs[name]
        end
    end)
end

-- Resize frame to fit
frame.Size = UDim2.new(0, 300, 0, y2 + math.ceil(#teleports/2) * 36 + 20)

print("Kairon Hub loaded!")
print("Key: kairon-script (auto-unlocked)")
